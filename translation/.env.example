# 'postgres' (jsonb column) or 'mysql' (json column) — selects both the TypeORM
# connection and which @TranslatableColumn()-decorated entity is registered.
DB_DRIVER=postgres
DATABASE_URL=postgres://nestjs-dash:nestjs-dash@localhost:5431/nestjs_dash_example_translation
MYSQL_URL=mysql://nestjs-dash:nestjs-dash@localhost:3306/nestjs-dash
PORT=4007
ADMIN_SESSION_SECRET=dev-only-insecure-secret-change-me

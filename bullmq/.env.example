DATABASE_URL=postgres://nestjs-dash:nestjs-dash@localhost:5431/nestjs_dash_example_bullmq
PORT=4005
ADMIN_SESSION_SECRET=dev-only-insecure-secret-change-me
REDIS_HOST=localhost
# The valkey service in the repo's docker-compose.yml maps to 6380, not
# Redis's default 6379 — that port was already taken by an unrelated
# container on the machine this was developed on.
REDIS_PORT=6380
